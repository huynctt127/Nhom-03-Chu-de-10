#include <iostream>     // Thu vien nhap xuat: cin, cout
#include <string>       // Thu vien su dung kieu string
#include <cstdio>       // Thu vien chua ham sscanf()

using namespace std;

//==================================================
// CLASS THUOC
//==================================================

 class Thuoc{

private:

    // Cac thuoc tinh cua thuoc
    string mathuoc;             // Ma thuoc
    string tenthuoc;            // Ten thuoc
    string hoatchat;            // Hoat chat
    string donvitinh;           // Don vi tinh
    float giaban;               // Gia ban
    int soluongtonkho;          // So luong thuoc ton kho
    string hansudung;           // Han su dung

public:

    //==================================================
    // HAM NHAP
    //==================================================

    void nhap() {

        cout << "Ma thuoc: ";
        cin >> mathuoc;         // Nhap ma thuoc

        cin.ignore();           // Xoa ky tu '\n' con lai sau cin

        cout << "Ten thuoc: ";
        getline(cin, tenthuoc); // Nhap ten thuoc, cho phep co khoang trang

        cout << "Hoat chat: ";
        getline(cin, hoatchat);  // Nhap hoat chat

        cout << "Don vi tinh: ";
        getline(cin, donvitinh); // Nhap don vi tinh

        cout << "Gia ban: ";

        // Kiem tra nguoi dung co nhap dung kieu so hay khong
        while (!(cin >> giaban)) {

            cout << "Gia ban phai la so! Nhap lai: ";

            cin.clear();            // Xoa trang thai loi cua cin
            cin.ignore(1000, '\n');  // Bo du lieu nhap sai trong bo dem
        }

        cout << "So luong ton kho: ";

        // Kiem tra so luong ton kho phai la so nguyen
        while (!(cin >> soluongtonkho)) {

            cout << "So luong phai la so! Nhap lai: ";

            cin.clear();            // Xoa trang thai loi
            cin.ignore(1000, '\n');  // Bo du lieu nhap sai
        }

        cin.ignore();              // Xoa ky tu '\n' truoc khi dung getline()

        cout << "Han su dung (dd/mm/yyyy): ";
        getline(cin, hansudung);   // Nhap han su dung dang chuoi
    }


    //==================================================
    // HAM XUAT
    //==================================================

    void xuat() {

        // Xuat lan luot thong tin cua mot thuoc
        cout << "Ma thuoc: " << mathuoc << endl;
        cout << "Ten thuoc: " << tenthuoc << endl;
        cout << "Hoat chat: " << hoatchat << endl;
        cout << "Don vi tinh: " << donvitinh << endl;
        cout << "Gia ban: " << giaban << endl;
        cout << "So luong ton kho: " << soluongtonkho << endl;
        cout << "Han su dung: " << hansudung << endl;
    }


    //==================================================
    // LAY MA THUOC
    //==================================================

    string getmathuoc() {

        return mathuoc;         // Tra ve ma thuoc
    }


    //==================================================
    // LAY TEN THUOC
    //==================================================

    string gettenthuoc() {

        return tenthuoc;        // Tra ve ten thuoc
    }


    //==================================================
    // HAM SAP XEP TANG DAN
    //==================================================

    void sapxeptang(Thuoc ds[], int n) {

        // Duyet tu phan tu dau den phan tu gan cuoi
        for (int i = 0; i < n - 1; i++) {

            // So sanh phan tu ds[i] voi cac phan tu phia sau
            for (int j = i + 1; j < n; j++) {

                int d1, m1, y1;     // Ngay, thang, nam cua thuoc thu i
                int d2, m2, y2;     // Ngay, thang, nam cua thuoc thu j

                // Tach chuoi han su dung dd/mm/yyyy thanh ngay, thang, nam
                sscanf(ds[i].hansudung.c_str(), "%d/%d/%d", &d1, &m1, &y1);
                sscanf(ds[j].hansudung.c_str(), "%d/%d/%d", &d2, &m2, &y2);

                // Chuyen ngay thang nam thanh mot so de de so sanh
                // Vi du: 23/03/2025 -> 20250323
                int ngay1 = y1 * 10000 + m1 * 100 + d1;
                int ngay2 = y2 * 10000 + m2 * 100 + d2;

                // Neu ngay thu nhat lon hon ngay thu hai
                // thi doi cho hai thuoc
                if (ngay1 > ngay2) {
                    Thuoc tam = ds[i];  // Luu tam thuoc thu i
                    ds[i] = ds[j];      // Dua thuoc thu j len vi tri i
                    ds[j] = tam;        // Dua thuoc cu o i xuong vi tri j
                }
            }
        }
    }


    //==================================================
    // HAM BO SUNG
    //==================================================

    void bosung(Thuoc ds[], int &n, int k) {

        // Kiem tra vi tri can bo sung
        if (k < 1 || k > n + 1) {

            cout << "Vi tri khong hop le!\n";

            return;                 // Dung ham neu vi tri khong hop le
        }

        k--;    // Chuyen vi tri nguoi dung nhap (1,2,3...)
                // thanh chi so mang (0,1,2...)

        Thuoc thuocmoi;             // Tao mot doi tuong thuoc moi

        cout << "\n========== NHAP THUOC MOI ==========\n";

        thuocmoi.nhap();            // Nhap thong tin thuoc moi

        // Dich cac phan tu sang phai de tao cho trong
        for (int i = n; i > k; i--) {
            ds[i] = ds[i - 1];
        }

        ds[k] = thuocmoi;            // Dua thuoc moi vao vi tri k

        n++;                          // Tang so luong thuoc len 1

        cout << "Bo sung thuoc thanh cong!\n";
    }


    //==================================================
    // HAM XOA
    //==================================================

    void xoa(Thuoc ds[], int &n, int k) {

        // Kiem tra vi tri can xoa
        if (k < 1 || k > n) {

            cout << "Vi tri khong hop le!\n";

            return;                  // Dung ham
        }

        k--;    // Chuyen vi tri tu 1,2,3... thanh chi so 0,1,2...

        // Dich cac phan tu phia sau sang trai
        for (int i = k; i < n - 1; i++) {

            ds[i] = ds[i + 1];
        }

        n--;    // Giam so luong thuoc di 1

        cout << "Xoa thuoc thanh cong!\n";
    }
};


//==================================================
// NHAP DANH SACH
//==================================================

void nhapdanhsach(Thuoc ds[], int n) {

    // Nhap lan luot n thuoc
    for (int i = 0; i < n; i++) {

        cout << "\n========== THUOC THU "
             << i + 1
             << " ==========\n";

        ds[i].nhap();       // Goi ham nhap cua tung thuoc
    }
}


//==================================================
// XUAT DANH SACH
//==================================================

void xuatdanhsach(Thuoc ds[], int n) {

    // Xuat lan luot n thuoc
    for (int i = 0; i < n; i++) {

        cout << "\n========== THUOC THU "
             << i + 1
             << " ==========\n";

        ds[i].xuat();       // Goi ham xuat cua tung thuoc
    }
}


//==================================================
// NHOM 1: TIM KIEM
//==================================================


//--------------------------------------------------
// TIM THEO MA
//--------------------------------------------------

void timtheoma(Thuoc ds[], int n) {

    string ma;                  // Luu ma thuoc can tim
    bool timthay = false;       // Kiem tra co tim thay thuoc hay khong

    cin.ignore();               // Xoa ky tu '\n' con lai trong bo nho dem

    cout << "Nhap ma thuoc can tim: ";

    getline(cin, ma);           // Nhap ma thuoc can tim

    // Duyet qua tung thuoc trong danh sach
    for (int i = 0; i < n; i++) {

        // So sanh ma can tim voi ma cua tung thuoc
        if (ds[i].getmathuoc() == ma) {

            cout << "\nTim thay thuoc:\n";

            ds[i].xuat();       // Xuat thong tin thuoc tim duoc

            timthay = true;     // Danh dau la da tim thay

            break;              // Tim thay roi thi dung vong lap
        }
    }

    // Neu duyet het danh sach ma khong tim thay
    if (!timthay) {

        cout << "Khong tim thay thuoc!\n";
    }
}


//--------------------------------------------------
// TIM THEO TEN
//--------------------------------------------------

void timtheoten(Thuoc ds[], int n) {

    string ten;                 // Luu ten thuoc can tim
    bool timthay = false;       // Kiem tra co tim thay thuoc hay khong

    cin.ignore();               // Xoa ky tu '\n' con lai

    cout << "Nhap ten thuoc can tim: ";

    getline(cin, ten);          // Nhap ten thuoc can tim

    // Duyet qua toan bo danh sach thuoc
    for (int i = 0; i < n; i++) {

        // So sanh ten can tim voi ten thuoc
        if (ds[i].gettenthuoc() == ten) {

            cout << "\nTim thay thuoc:\n";

            ds[i].xuat();       // Xuat thong tin thuoc tim duoc

            timthay = true;     // Danh dau da tim thay
        }
    }

    // Neu khong tim thay thuoc
    if (!timthay) {

        cout << "Khong tim thay thuoc!\n";
    }
}


//==================================================
// NHOM 2: SAP XEP
//==================================================

void sapxep(Thuoc ds[], int n) {

    Thuoc t;                    // Tao mot doi tuong thuoc tam

    t.sapxeptang(ds, n);        // Goi ham sap xep tang dan theo han su dung

    cout << "\nDa sap xep tang dan theo han su dung!\n";
}


//==================================================
// NHOM 3: BO SUNG
//==================================================

void bosungthuoc(Thuoc ds[], int &n) {

    int k;                      // Vi tri can bo sung

    cout << "Nhap vi tri can bo sung (1 -> "
         << n + 1
         << "): ";

    cin >> k;                   // Nhap vi tri can bo sung

    Thuoc t;                    // Tao doi tuong thuoc tam

    t.bosung(ds, n, k);         // Goi ham bo sung thuoc
}


//==================================================
// NHOM 4: XOA
//==================================================

void xoathuoc(Thuoc ds[], int &n) {

    int k;                      // Vi tri can xoa

    cout << "Nhap vi tri can xoa (1 -> "
         << n
         << "): ";

    cin >> k;                   // Nhap vi tri can xoa

    Thuoc t;                    // Tao doi tuong thuoc tam

    t.xoa(ds, n, k);            // Goi ham xoa thuoc
}


//==================================================
// HAM MAIN
//==================================================

int main() {

    Thuoc ds[200];              // Khai bao mang chua toi da 200 thuoc

    int n;                      // So luong thuoc

    int luachon;                // Luu lua chon trong menu


    //==================================================
    // NHAP SO LUONG
    //==================================================

    do {

        cout << "Nhap so luong thuoc (0 < n < 200): ";

        cin >> n;               // Nhap so luong thuoc

    } while (n <= 0 || n >= 200);   // Nhap lai neu n nam ngoai khoang cho phep


    //==================================================
    // NHAP DANH SACH
    //==================================================

    cout << "\n========== NHAP DANH SACH THUOC ==========\n";

    nhapdanhsach(ds, n);        // Goi ham nhap danh sach thuoc


    //==================================================
    // MENU
    //==================================================

    do {

        cout << "\n\n========================================\n";

        cout << "             QUAN LY THUOC\n";

        cout << "========================================\n";

        cout << "1. Xuat danh sach\n";

        cout << "2. Tim theo ma\n";

        cout << "3. Tim theo ten\n";

        cout << "4. Sap xep theo han su dung\n";

        cout << "5. Bo sung thuoc\n";

        cout << "6. Xoa thuoc\n";

        cout << "0. Thoat\n";

        cout << "========================================\n";

        cout << "Nhap lua chon: ";

        cin >> luachon;         // Nhap lua chon cua nguoi dung


        // Kiem tra lua chon va thuc hien chuc nang tuong ung
        switch (luachon) {

        case 1:

            xuatdanhsach(ds, n);    // Goi ham xuat danh sach

            break;


        case 2:

            timtheoma(ds, n);       // Goi ham tim thuoc theo ma

            break;


        case 3:

            timtheoten(ds, n);      // Goi ham tim thuoc theo ten

            break;


        case 4:

            sapxep(ds, n);          // Goi ham sap xep theo han su dung

            break;


        case 5:

            bosungthuoc(ds, n);     // Goi ham bo sung thuoc

            break;


        case 6:

            xoathuoc(ds, n);        // Goi ham xoa thuoc

            break;


        case 0:

            cout << "Ket thuc chuong trinh!\n";

            break;


        default:

            cout << "Lua chon khong hop le!\n";   // Bao loi neu chon sai
        }

    } while (luachon != 0);         // Lap menu cho den khi chon 0


    return 0;                       // Ket thuc chuong trinh
}
