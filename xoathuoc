 // Ham xoa thuoc tai vi tri k
    void xoa(Thuoc ds[], int &n, int k) {

        // Kiem tra vi tri
        if (k < 1 || k > n) {
            cout << "Vi tri khong hop le!\n";
            return;
        }

        // Chuyen vi tri tu 1,2,3... thanh 0,1,2...
        k--;

        // Dich cac phan tu phia sau sang trai
        for (int i = k; i < n - 1; i++) {
            ds[i] = ds[i + 1];
        }

        // Giam so luong thuoc
        n--;

        cout << "Xoa thuoc thanh cong!\n";
    }
};
